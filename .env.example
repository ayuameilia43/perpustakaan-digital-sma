# ============================================================
# Perpustakaan Digital SMA - Environment Variables
# ============================================================
# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah mengunggah .env ke repository.

# --- Database (Neon PostgreSQL) ---
# Koneksi pooled untuk runtime aplikasi (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require&channel_binding=require"
# Koneksi direct untuk prisma db push / migrate (bukan runtime)
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require&channel_binding=require"

# --- Autentikasi (NextAuth.js) ---
# Secret untuk JWT session dan enkripsi API key AI di database.
# Hasilkan dengan: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"
# URL produksi aplikasi (isi setelah deployment, contoh: https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# --- Telegram (opsional) ---
# Token bot dari @BotFather. Jika kosong, polling Telegram tidak dimulai.
TELEGRAM_BOT_TOKEN=""
# Chat ID tujuan notifikasi
TELEGRAM_CHAT_ID=""
# Username bot (tanpa @) untuk link pengguna
TELEGRAM_BOT_USERNAME=""

# --- AI (opsional, fallback) ---
# API key fallback jika key tersimpan di database gagal didekripsi
NVIDIA_API_KEY=""
# Base URL API AI (default: NVIDIA NIM)
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# Override kunci enkripsi AI key (opsional, default: NEXTAUTH_SECRET)
AI_CONFIG_ENCRYPTION_KEY=""
